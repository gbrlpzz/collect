{
  "name": "collect",
  "private": true,
  "version": "0.1.2",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "format": "npm run format:web && npm run format:edge",
    "format:web": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" vite.config.ts index.html \"docs/*.md\" README.md package.json",
    "format:edge": "deno fmt supabase/functions",
    "format:check": "npm run format:web:check && npm run format:edge:check",
    "format:web:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" vite.config.ts index.html \"docs/*.md\" README.md package.json",
    "format:edge:check": "deno fmt --check supabase/functions",
    "test": "vitest run",
    "test:a11y": "vitest run tests/accessibility.test.tsx",
    "check": "npm run format:check && npm test && npm run build",
    "provision": "node scripts/provision.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tus-js-client": "4.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
