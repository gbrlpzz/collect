VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy name accepted for existing Supabase projects.
VITE_SUPABASE_ANON_KEY=
VITE_APP_VERSION=0.1.2
# Canonical browser origin used in magic-link emails. ALWAYS set this to the deployed
# app origin (never localhost): links requested from any preview or local page then
# return to the real app. Defaults to window.location.origin when empty.
VITE_APP_URL=
# Used as the default in the first-workspace setup form.
VITE_ORGANIZATION_NAME=
